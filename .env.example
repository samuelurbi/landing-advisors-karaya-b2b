# Destino del formulario (POST JSON). Vacío: /api/enviar.php en el build (PHP del zip de Hostinger)
# y envío simulado en `npm run dev`. Las claves de MySQL/SMTP NO van aquí: domains/<dominio>/config.php.
VITE_FORM_ENDPOINT=
# 1 = oculta las marcas ◆ de datos pendientes (publicación final).
VITE_OCULTAR_PENDIENTES=
# Dominio final (sin barra al final): canonical, og:url, og:image, sitemap y llms.txt. Lo usa el build.
SITIO=https://landing-advisors-karaya.vercel.app
# 1 = indexable (quita noindex y abre robots.txt). Solo al lanzar en el subdominio final.
INDEXAR=
