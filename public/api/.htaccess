# /api: solo se puede llamar a enviar.php. reglas.json, lib/ y cualquier otro archivo quedan
# bloqueados, y no se lista la carpeta.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <Files "enviar.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "enviar.php">
    Allow from all
  </Files>
</IfModule>
